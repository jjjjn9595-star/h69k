    phy@fe820000 {
        compatible = "rockchip,rk3568-naneng-combphy";
        reg = <0x00000000 0xfe820000 0x00000000 0x00000100>;
        clocks = <0x0000001d 0x0000001f 0x0000000e 0x0000017c 0x0000000e 0x0000007f>;
        clock-names = "ref", "apb", "pipe";
        assigned-clocks = <0x0000001d 0x0000001f>;
        assigned-clock-rates = <0x05f5e100>;
        resets = <0x0000000e 0x000001c5>;
        reset-names = "phy";
        rockchip,pipe-grf = <0x000000bd>;
        rockchip,pipe-phy-grf = <0x000000d8>;
        #phy-cells = <0x00000001>;
        status = "okay";
        phandle = <0x00000013>;
    };
