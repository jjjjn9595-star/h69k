        resets = <0x0000000e 0x000000d7>;
        reset-names = "stmmaceth";
        rockchip,grf = <0x0000001e>;
        snps,axi-config = <0x000000d5>;
        snps,mixed-burst;
        snps,mtl-rx-config = <0x000000d6>;
        snps,mtl-tx-config = <0x000000d7>;
        snps,tso;
        status = "disabled";
        mdio {
            compatible = "snps,dwmac-mdio";
            #address-cells = <0x00000001>;
            #size-cells = <0x00000000>;
